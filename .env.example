# Copy to .env and fill in. Everything runs without this file too -
# the agent falls back to a deterministic heuristic scorer when no key
# is present, so you can develop and demo the whole pipeline offline.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Where the SQLite system of record lives. Defaults to ./lead_router.db
LEAD_ROUTER_DB=./lead_router.db

# Optional shared-secret auth for the agent service (see agent/security.py).
# Leave unset for local dev - every route stays open, which is what the
# test suite and localhost demos want. Set it the moment this deploys
# anywhere reachable beyond your own machine, and pass the same value as
# an X-API-Key header from n8n's HTTP Request node.
AGENT_API_KEY=

# --- Go-live: these two are what make hot/warm leads actually notify someone ---
# Slack Incoming Webhook URLs - one per notification node in
# n8n/lead-intake-workflow.json. Create one in under 2 minutes:
# https://api.slack.com/apps -> your app -> Incoming Webhooks -> Add New Webhook.
# Can point at the same channel or two different ones. Read by the n8n
# container via docker-compose.yml, not by the Python agent service.
SLACK_WEBHOOK_HOT=
SLACK_WEBHOOK_WARM=
